DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=1
# Comma-separated hostnames, e.g. yourusername.pythonanywhere.com
DJANGO_ALLOWED_HOSTS=*
# Comma-separated full origins (scheme+host), e.g. https://yourusername.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=

GEMINI_API_KEY=
GROK_API_KEY=
GROK_MODEL=llama-3.3-70b-versatile

# Only used for AI-generated illustrative images (DALL-E 3). Leave blank to disable
# that one feature; text generation is unaffected.
OPENAI_API_KEY=

# Unused in production (the dissertation chat flow is synchronous); only the legacy
# /generate-dissertation/ endpoint touches Celery, and nothing in the frontend calls it.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Stripe billing (leave blank to run without payments; everyone stays on Free).
# Use test-mode keys (sk_test_..., whsec_...) until you're ready to take real money.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs from the Stripe dashboard: Pro monthly/yearly are recurring, the pass is one-time.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_THESIS_PASS=
FRONTEND_URL=http://localhost:5173
BILLING_FREE_MONTHLY_AI_LIMIT=30
BILLING_PRO_MONTHLY_AI_LIMIT=1000
BILLING_THESIS_PASS_DAYS=30
